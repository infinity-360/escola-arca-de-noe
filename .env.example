# ============================================================
#  Escola Arca de Noé — configuração do servidor
#  Copie este arquivo para ".env" e preencha os valores.
# ============================================================

PORT=3000
NODE_ENV=production
# Endereço público do site (usado nos links enviados por e-mail/WhatsApp)
SITE_URL=https://www.seudominio.com.br
# true se estiver atrás de proxy/HTTPS (Render, Railway, Nginx, Cloudflare)
TRUST_PROXY=true
# Pasta onde ficam o banco de dados e os uploads (use um disco persistente)
DATA_DIR=./data

# ---------- Primeiro acesso da direção ----------
# Opção A: defina abaixo para criar o diretor automaticamente ao iniciar.
# Opção B: deixe vazio e crie a conta em /equipe.html no primeiro acesso.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_WHATSAPP=
# Chave exigida na tela de configuração inicial (recomendado em produção)
SETUP_KEY=

# ---------- E-mail (SMTP) ----------
# Gmail: smtp.gmail.com, porta 465, use uma "senha de app" (https://myaccount.google.com/apppasswords)
# Outros: Hostinger, Locaweb, Zoho, Brevo, SendGrid, Amazon SES etc.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Escola Arca de Noé <contato@seudominio.com.br>"

# ---------- WhatsApp ----------
# Escolha um provedor: zapi | evolution | meta | webhook
# Sem provedor, a equipe usa o botão "💬 envio manual" no mural.
WHATSAPP_PROVIDER=
# Intervalo entre mensagens (ms) para evitar bloqueios
WHATSAPP_DELAY_MS=1200

# Z-API (https://z-api.io)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Evolution API (auto-hospedada)
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_APIKEY=

# WhatsApp Cloud API oficial (Meta)
META_WA_TOKEN=
META_WA_PHONE_ID=
META_WA_VERSION=v21.0
# Modelo aprovado (necessário para iniciar conversas); deve ter 1 variável no corpo
META_WA_TEMPLATE=
META_WA_TEMPLATE_LANG=pt_BR

# Webhook genérico (n8n, Make, Zapier...) — recebe POST {phone, message}
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
